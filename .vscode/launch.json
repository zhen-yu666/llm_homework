{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "T1: 构建索引 + 基线 RAG",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/scripts/run_t1.py",
			"args": [
				"--build-index"
			],
			"cwd": "${workspaceFolder}",
			"envFile": "${workspaceFolder}/.env",
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"name": "T7: 快速评估（跳过 LLM 生成指标）",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/scripts/run_t7.py",
			"args": [
				"--skip-gen-eval"
			],
			"cwd": "${workspaceFolder}",
			"envFile": "${workspaceFolder}/.env",
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"name": "T8-1: 幻觉治理对比",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/scripts/run_t8_1.py",
			"cwd": "${workspaceFolder}",
			"envFile": "${workspaceFolder}/.env",
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"name": "当前打开的脚本",
			"type": "debugpy",
			"request": "launch",
			"program": "${file}",
			"cwd": "${workspaceFolder}",
			"envFile": "${workspaceFolder}/.env",
			"console": "integratedTerminal",
			"justMyCode": true
		}
	]
}
